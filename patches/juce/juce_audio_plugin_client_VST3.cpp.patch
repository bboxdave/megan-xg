+    // A host's normalised MIDI-CC parameter value -> the 0..127 controller value.
+    //
+    // JUCE's floor(v * 128) is exact for a host that sends L/127, which Bitwig does
+    // (measured). CUBASE DOES NOT, and it uses a DIFFERENT encoding per kind of lane
+    // (measured 2026-10-07, all values typed into the lane, transport stopped):
+    //   * a unipolar lane (Volume, CC7) sends L as L+1 on a 0..128 scale squeezed onto
+    //     0..127 about a fixed 64:  v*127 = L+1 (L <= 63), 64 + (L-63)*63/64 (L >= 63)
+    //   * a bipolar lane (Pan, CC10, shown L63..C..R63) sends raw r in 14 bits as
+    //     r*130 (r <= 63) and (r+1)*128 (r >= 64), over 16383
+    // floor(v * 128) put Volume one step high almost everywhere, and Pan one step high
+    // from C rightwards; the device played off the lane and the MIDI override mark
+    // never cleared at equality.
+    //
+    // ONE decode serves both: subtract a bias that grows with the value up to 64 and
+    // then holds. Any bias peak from 0.504 to 0.988 decodes every value of BOTH models
+    // exactly; 0.75 is the middle. The tight end is the bottom, where Pan L63 and Volume
+    // lane 0 arrive 0.008 of a step apart -- far above float error, and Cubase sends
+    // the same bits every time. Not a host-agnostic rule: Cubase lane 63 and Bitwig
+    // lane 64 send the SAME number, so the decode is per host.
+    // Controllers only -- channel pressure and pitch bend were not measured.
+    static int mu100HostCcToMidi (double value)
+    {
+        static const bool cubaseScale = [] {
+            const PluginHostType host;
+            return host.isCubase() || host.isNuendo();
+        }();
+
+        const double x = jlimit (0.0, 1.0, value) * 128.0;
+
+        if (! cubaseScale)
+            return jlimit (0, 127, (int) x);
+
+        return jlimit (0, 127, (int) (x - 0.75 * jmin (x, 64.0) / 64.0));
+    }
+   #endif
